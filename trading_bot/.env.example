# PostgreSQL Database Connection (e.g. Neon, AWS, Supabase, local)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# NAS100 Scalper Bot Configuration
TRADING_BOT_SYMBOL=NAS100
TRADING_BOT_TIMEFRAME=M5

# Execution & Risk Management
INITIAL_ORDERS_COUNT=2
MAX_ACTIVE_ORDERS=10
MAX_TOTAL_RISK_PCT=0.10
PROFIT_TARGET_PCT_PER_ORDER=0.20
DAILY_DRAWDOWN_LIMIT_PCT=0.20
SL_BUFFER_POINTS=5.0
MIN_SL_DISTANCE_POINTS=10.0

# Execution Mode: "paper" (simulation) or "mt5" (live MetaTrader 5 terminal)
TRADING_BOT_MODE=paper
MAGIC_NUMBER=100500
POLL_INTERVAL_SECONDS=3.0

# Optional: MetaTrader 5 Terminal Credentials
# (If left empty, the bot automatically connects to the currently active MT5 terminal)
# MT5_LOGIN=12345678
# MT5_PASSWORD=your_password
# MT5_SERVER=YourBroker-Demo
# MT5_PATH="C:\Program Files\MetaTrader 5\terminal64.exe"
